# Copy this file to .env and replace the sample values. Never commit .env.

# --- Dedicated Foundry account (Assistant GM role) ---
AI_USER=AI
AI_PASSWORD=change-me

# Optional Foundry admin password (depends on the MCP server setup).
ADMIN_PASSWORD=

# Allowed Foundry user IDs, comma-separated.
# Empty means every player can talk to the agent (trusted-group default).
ALLOWED_SENDERS=

# --- OpenCode V2 (required; V1 is unsupported) and model ---
# Verify with: npm run check:opencode:v2
# V2 npm package: @opencode/cli (not the old opencode-ai V1 package).
# Old V1 conversations are not migrated; Foundry chat cursors are retained.
OPENCODE_BIN=opencode
# Provider/model identifier; change to match your OpenCode configuration.
OPENCODE_MODEL=openrouter/baidu/ernie-5.5-flash-preview:free

# --- Provider API key (OpenRouter) ---
# Read automatically by OpenCode from the environment.
OPENROUTER_API_KEY=sk-or-...

# --- Foundry MCP connection ---
# MCP endpoint (commonly http://127.0.0.1:8808/mcp).
FOUNDRY_MCP_URL=http://127.0.0.1:8808/mcp
# Base64-encoded Basic authentication value for "username:password".
# Generate with: printf 'AI:your-password' | base64
FOUNDRY_MCP_AUTH_B64=QUk6Y2hhbmdlLW1l
# Module exporting FoundrySession. The dependency is installed from the pinned
# GitHub source, and its client is under src/foundry.mjs (not the server entry).
# A local file path is also supported, e.g. /opt/foundry-vtt-mcp-server/src/foundry.mjs.
FOUNDRY_MCP_MODULE=foundry-vtt-mcp-server/src/foundry.mjs

# --- Bridge settings (optional) ---
POLL_MS=3000
MAX_REPLY=4000
RESET_MS=86400000
RESET_MSGS=1000
# Maximum number of players processed concurrently (1–16; default 3).
MAX_CONCURRENT=3
# Timestamp-filtered chat polling: auto probes server support; off always fetches all.
CHAT_FILTER_MODE=auto
# Full chat recheck and overlapping incremental query window (milliseconds).
CHAT_RESYNC_MS=120000
CHAT_LOOKBACK_MS=120000
# Local checkpoint path; empty uses .state/bridge-state.json in the project.
STATE_FILE=

# --- D&D 2024 rules citation verification ---
# Enforce source/page verification on explicit rules questions (off disables).
RULES_CITATION_MODE=enforce
# Full rules corpus created by rules:setup; empty means .rules/rules-index.json.
RULES_INDEX_PATH=
# Private JSON listing books whose rules players can see. Unlisted PDFs are GM-only.
# Empty means rules-private/access.json; SRD 5.2.1 always remains public.
RULES_ACCESS_FILE=
# Optional MCP stderr metrics: search/read duration, result count and output characters (no query text).
RULES_SEARCH_METRICS=0
