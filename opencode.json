{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "servers": {
      "rules": {
        "type": "local",
        "command": ["node", "rules-mcp.mjs"],
        "cwd": ".",
        "codemode": false
      },
      "foundry": {
        "type": "remote",
        "url": "{env:FOUNDRY_MCP_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Basic {env:FOUNDRY_MCP_AUTH_B64}"
        }
      }
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "baidu/ernie-5.5-flash-preview:free": {
          "limit": {
            "output": 500
          }
        }
      }
    }
  }
}
