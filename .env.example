# Copie ce fichier en .env et remplis les valeurs. Ne versionne jamais .env.

# --- Compte Foundry dédié à l'agent (rôle assistant MJ) ---
AI_USER=AI
AI_PASSWORD=change-me

# Mot de passe admin Foundry (optionnel, selon la config du serveur MCP).
ADMIN_PASSWORD=

# Expéditeurs autorisés (ids Foundry, séparés par des virgules).
# Vide = TOUT LE MONDE peut parler à l'agent (assistant MJ public).
ALLOWED_SENDERS=

# --- opencode / modèle ---
OPENCODE_BIN=opencode
# Identifiant du modèle (provider/model). Laisse la valeur par défaut ou change.
OPENCODE_MODEL=openrouter/baidu/ernie-5.5-flash-preview:free

# --- Clé API du provider (OpenRouter) ---
# Lue automatiquement par opencode depuis l'environnement.
OPENROUTER_API_KEY=sk-or-...

# --- Connexion MCP Foundry ---
# URL du serveur MCP (souvent http://127.0.0.1:8808/mcp).
FOUNDRY_MCP_URL=http://127.0.0.1:8808/mcp
# En-tête Basic en base64 de "utilisateur:motdepasse" du compte MCP.
# Génère-le avec : printf 'AI:monmotdepasse' | base64
FOUNDRY_MCP_AUTH_B64=QUk6Y2hhbmdlLW1l
# Module exposant FoundrySession. Dépendance npm par défaut ; sur un serveur
# Foundry existant, pointe le fichier local (ex. /opt/foundry-vtt-mcp-server/src/foundry.mjs).
FOUNDRY_MCP_MODULE=foundry-vtt-mcp-server

# --- Réglages du pont (optionnels) ---
POLL_MS=3000
MAX_REPLY=4000
RESET_MS=86400000
RESET_MSGS=1000