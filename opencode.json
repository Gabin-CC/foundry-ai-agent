{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_MODEL}",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "foundry": {
      "type": "remote",
      "url": "{env:FOUNDRY_MCP_URL}",
      "enabled": true,
      "headers": {
        "Authorization": "Basic {env:FOUNDRY_MCP_AUTH_B64}"
      }
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "baidu/ernie-5.5-flash-preview:free": {
          "options": {
            "max_tokens": 500
          }
        }
      }
    }
  }
}