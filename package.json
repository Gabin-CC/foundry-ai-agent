{
  "name": "foundry-ai-agent",
  "version": "0.2.0",
  "description": "Foundry VTT chat-to-OpenCode bridge: an AI assistant that answers whispers and accesses Foundry through MCP.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "foundry-ai-agent": "listen.mjs"
  },
  "scripts": {
    "start": "node listen.mjs",
    "test": "node --test tests/*.test.mjs",
    "rules:setup": "node scripts/prepare-rules.mjs",
    "rules:optimize": "node scripts/optimize-rules.mjs",
    "eval:rules": "node scripts/evaluate-rules.mjs",
    "eval:rules:live": "node scripts/evaluate-rules-live.mjs",
    "check:opencode:v2": "node scripts/check-opencode-v2.mjs",
    "check:release": "node scripts/check-release.mjs",
    "smoke:foundry": "bash scripts/smoke-test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "foundry-vtt-mcp-server": "git+https://github.com/Gabin-CC/foundry-vtt-mcp-server.git#8bf867431537fcee35695a8e0f77cc625ca8c6b9"
  }
}
